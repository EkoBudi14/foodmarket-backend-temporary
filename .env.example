# Copy to .env.local for `vercel dev`. Never commit the real file.

# Midtrans Server Key (Sandbox keys start with "SB-Mid-server-" or "Mid-server-")
MIDTRANS_SERVER_KEY=
# "false" = Sandbox, "true" = Production
MIDTRANS_IS_PRODUCTION=false

# Full JSON of the Firebase service account key, on ONE line.
# Firebase Console > Project settings > Service accounts > Generate new private key
FIREBASE_SERVICE_ACCOUNT=

# dummyjson prices are in USD; this converts them to IDR for Midtrans.
USD_TO_IDR=16000
